{
  "name": "playwright-api-test-framework",
  "version": "1.0.0",
  "description": "Production-ready API testing framework using Playwright",
  "scripts": {
    "test": "npx playwright test tests/api",
    "test:reqres": "npx playwright test tests/api/reqres",
    "test:booker": "npx playwright test tests/api/booker",
    "test:ci": "npx playwright test tests/api --reporter=html,list,json",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.44.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
